{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "ignoreCommand": "bash -c 'changed=$(git diff --name-only HEAD^ HEAD); web_related=$(echo \"$changed\" | grep -vE \"^apps/mobile/\" | wc -l); [ \"$web_related\" -eq 0 ]'",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "albumfifaindex.com" }],
      "destination": "https://albumfan.com/$1?ref=old",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mialbumfifa.com" }],
      "destination": "https://albumfan.com/$1?ref=old",
      "permanent": true
    }
  ]
}
