{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "albumfifaindex.com" }],
      "destination": "https://mialbumfifa.com/$1?ref=old",
      "permanent": true
    }
  ]
}
