{
  "name": "mi-album-fifa",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "build:mobile:android": "npm run build:android --workspace=apps/mobile",
    "build:mobile:ios": "npm run build:ios --workspace=apps/mobile",
    "bump-version": "npm run bump-version --workspace=apps/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/mobile/tsconfig.json",
    "typecheck:web": "tsc --noEmit",
    "typecheck:mobile": "tsc --noEmit -p apps/mobile/tsconfig.json",
    "test": "vitest run --config packages/shared/vitest.config.ts && vitest run --config apps/mobile/vitest.config.ts",
    "test:shared": "vitest run --config packages/shared/vitest.config.ts",
    "test:mobile": "vitest run --config apps/mobile/vitest.config.ts",
    "release": "npm run export --workspace=apps/mobile && npm run bump-version && npm run build:mobile:android && npm run release:commit",
    "release:commit": "git add apps/mobile/app.json && git commit -m \"Bump version to $(node -e \"console.log(require('./apps/mobile/app.json').expo.version)\")\" && git push",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
