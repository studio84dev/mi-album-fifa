{
  "expo": {
    "name": "Mi Album FIFA",
    "slug": "mi-album-fifa",
    "version": "1.0.0",
    "owner": "robertoandres24",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mi-album-fifa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studio84.mialbumfifa",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.studio84.mialbumfifa",
      "versionCode": 1,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b5c43d5-2231-48f0-a8d3-3a7639eba5cf"
      }
    }
  }
}
